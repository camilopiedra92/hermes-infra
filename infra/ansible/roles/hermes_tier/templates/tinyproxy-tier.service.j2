# {{ ansible_managed }}
[Unit]
Description=Egress proxy of the tier account (named domains only)
After=nftables.service network.target
Requires=nftables.service
Before=user@{{ hermes_tier_uid }}.service

[Service]
ExecStart=/usr/bin/tinyproxy -d -c /etc/tinyproxy/tinyproxy-{{ hermes_tier_name }}.conf
ExecReload=/bin/kill -USR1 $MAINPID
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=20
PrivateDevices=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
ReadWritePaths=/run/tinyproxy-{{ hermes_tier_name }}
RuntimeDirectory=tinyproxy-{{ hermes_tier_name }}
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
Restart=on-failure

[Install]
WantedBy=multi-user.target

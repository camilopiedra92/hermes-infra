# {{ ansible_managed }}
# Hermes managed scope for the {{ hermes_tier_name }} tier (docs/ARCHITECTURE.md). Owned by root in /etc/hermes-{{ hermes_tier_name }}.
# This tier reads untrusted content and holds no host or cloud credential{{ ': its tools run in a rootless container, never on the host' if hermes_tier_sandbox else '; it has no shell and its file writes stay in one workspace folder' }}.

security:
  allow_lazy_installs: false

telemetry:
  shared_metrics:
    enabled: false
    send: false

# Search and page reading go through one pinned free keyless vendor that fetches the pages itself, so the tier never
# connects to an arbitrary host and a URL pointing at a private range cannot be reached from here.
web:
  backend: keenable
  provider_tier:
    keenable: free
  keyless_fallback: false
  keyless_rescue: false

gateway:
  systemd_watchdog_seconds: 120

platform_toolsets:
  telegram:
{% for toolset in hermes_tier_def.toolsets %}
    - {{ toolset }}
{% endfor %}

agent:
  disabled_toolsets:
{% for toolset in hermes_tier_def.disabled_toolsets %}
    - {{ toolset }}
{% endfor %}
{% if hermes_tier_sandbox %}

# Every command runs in a rootless container with the stock crun runtime (docs/ARCHITECTURE.md, Sandbox). Hermes already
# drops all capabilities but five, sets no-new-privileges, mounts tmpfs and applies cpu, memory and pids limits.
# Extra run flags would only duplicate or collide with those.
terminal:
  backend: docker
  # The image is pinned by content: its ID is the sha256 of its config, which covers every layer (bin/hermes/pins.json).
  # Hermes pulls an image only when it is absent locally, and the tier has no registry egress, so it never pulls.
  docker_image: "{{ hermes_tier_image_id }}"
  docker_network: false
  container_cpu: 1
  container_memory: 1024
  container_persistent: true
  # Files the tier produces for the owner (MEDIA delivery): the only host path the container sees.
  docker_volumes:
    - {{ hermes_tier_hermes_home }}/cache/documents:/output
{% endif %}
{% if hermes_tier_def.mcp_servers is defined %}

# Remote MCP servers over OAuth. The tokens stay in the tier's own home (mode 600) and never leave it. Every write a tool
# makes asks the owner first (trust: untrusted); a cron run cannot ask, so it can only read. A Google OAuth client is the
# owner's own, kept in the tier's .env and referenced here, so nothing secret is in this world-readable file.
mcp_servers:
{% for name, server in hermes_tier_def.mcp_servers.items() %}
  {{ name }}:
    url: {{ server.url }}
    auth: oauth
    trust: untrusted
{% if server.oauth_client %}
    oauth:
      client_id: "${GOOGLE_OAUTH_CLIENT_ID}"
      client_secret: "${GOOGLE_OAUTH_CLIENT_SECRET}"
{% endif %}
{% endfor %}
{% endif %}

approvals:
  mode: manual
  timeout: 300
  cron_mode: deny
  single_query_mode: deny
  unattended_mode: deny

model:
  provider: {{ hermes_pins.model.provider }}
  default: {{ hermes_pins.model.default_model }}

auth:
  adopt_external_logins: false

updates:
  check: false

plugins:
  auto_apply: false
  entries:
    {{ hermes_pins.model.provider }}:
      settings:
        claude_config_dir: {{ hermes_tier_claude_config_dir }}
        claude_code_telemetry: false

providers:
  {{ hermes_pins.model.provider }}:
    stale_timeout_seconds: {{ hermes_pins.model.stale_timeout_seconds }}

skills:
  guard_agent_created: true
  write_approval: false

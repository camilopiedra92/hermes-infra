#!/usr/sbin/nft -f
# {{ ansible_managed }}
# Fail closed for the worker account (docs/ARCHITECTURE.md). The worker reads untrusted content, so the gateway may
# reach only the local proxy (which allows named domains) and the loopback relay of the model plugin. It cannot
# reach the tailnet, private ranges, the host's services, or the internet directly. There is no DNS for the uid.
# The containers run under this uid too, with no network device of their own, so the same rule bounds them.

table inet hermes_worker
delete table inet hermes_worker

table inet hermes_worker {
  counter hermes_worker_held {}
  counter hermes_worker_proxy {}
  counter hermes_worker_loopback {}

  chain output {
    type filter hook output priority -1; policy accept;
    meta skuid {{ hermes_worker_uid }} oifname "lo" ip daddr 127.0.0.1 tcp dport {{ hermes_pins.egress.worker.proxy_port }} counter name "hermes_worker_proxy" accept
    meta skuid {{ hermes_worker_uid }} oifname "lo" ip daddr 127.0.0.1 tcp dport 32768-60999 counter name "hermes_worker_loopback" accept
    meta skuid {{ hermes_worker_uid }} counter name "hermes_worker_held" drop
  }
}

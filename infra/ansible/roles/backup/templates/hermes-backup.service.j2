# {{ ansible_managed }}
[Unit]
Description=Back up the Hermes state to R2 (restic)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hermes-backup
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectHome=false
ProtectSystem=strict
ReadWritePaths={{ backup_state_dir }} {{ backup_state_paths | join(' ') }}
NoNewPrivileges=true
CacheDirectory=hermes-backup
Environment=RESTIC_CACHE_DIR=/var/cache/hermes-backup
Environment=HERMES_BACKUP_STATES={{ backup_state_paths | join(':') }}

# {{ ansible_managed }}
# The Hermes bot is the single entry point for development, administration and operation of this host, and it has total
# control. Every sudo command and sub-command is logged as text. The terminal I/O is not recorded here: Hermes keeps every
# tool call and its output in the session store, which is backed up, and a sudo I/O log of the bot costs about sixteen inodes
# per command, which exhausted the capped volume of the operator's logs.
Defaults:{{ operator_user }} use_pty, log_subcmds
Defaults:{{ operator_user }} !log_input, !log_output
Defaults:{{ operator_user }} logfile={{ operator_sudo_logfile }}
{{ operator_user }} ALL=(ALL:ALL) NOPASSWD: ALL

#!/bin/bash
# Put one runtime secret into the service user's .env, without the secret ever being logged.
#
# Usage: sudo hermes-secret-put KEY      (the value is typed at the prompt, nothing is echoed)
#   TELEGRAM_BOT_TOKEN   one line of the service user's .env, for the gateway
#   GITHUB_TOKEN         a file only the bot's administration account reads, for git and the GitHub API (ADR-0029)
#
# The value is read from standard input, never from the command line, so it is not in the sudo text log,
# the process list or the shell history. The sudoers rule for this one command carries NOLOG_INPUT and
# NOLOG_OUTPUT, so the sudo I/O log does not record what is typed (ADR-0023, ADR-0026).
# Only the keys named below are accepted, and each is checked against the shape of the real value, so a
# paste of the wrong thing is refused before it is written. The file is replaced atomically, 0600, owned by
# the service user. The value is never printed.
set -euo pipefail
umask 077

key=${1:?key (one of: TELEGRAM_BOT_TOKEN, GITHUB_TOKEN)}
[[ $# -eq 1 ]] || { echo "hermes-secret-put: exactly one argument, the key name" >&2; exit 2; }

case $key in
  TELEGRAM_BOT_TOKEN)
    shape='^[0-9]{6,12}:[A-Za-z0-9_-]{30,50}$'
    service_user=hermes
    kind='env'
    rel=.hermes/.env
    ;;
  GITHUB_TOKEN)
    # A fine-grained token (github_pat_...) or a classic one (ghp_, gho_, ghu_, ghs_, ghr_). The owner scopes it to one repository.
    shape='^(github_pat_[A-Za-z0-9_]{40,255}|gh[pousr]_[A-Za-z0-9]{30,255})$'
    service_user=hermesadmin
    kind=raw
    rel=.config/hermes/github-token
    ;;
  *)
    echo "hermes-secret-put: refusing key ${key}" >&2
    exit 2
    ;;
esac

if [[ -n ${HERMES_SECRET_ENV_FILE:-} ]]; then
  dest=$HERMES_SECRET_ENV_FILE
else
  home=$(getent passwd "$service_user" | cut -d: -f6)
  [[ -n $home ]] || { echo "hermes-secret-put: no user ${service_user}" >&2; exit 2; }
  dest=$home/$rel
fi
dir=$(dirname -- "$dest")
[[ -d $dir ]] || { echo "hermes-secret-put: ${dir} does not exist" >&2; exit 2; }

if [[ -t 0 ]]; then
  IFS= read -r -s -p "${key}: " value
  echo >&2
else
  IFS= read -r value || true
fi
value=${value%$'\r'}
if [[ ! $value =~ $shape ]]; then
  echo "hermes-secret-put: the value does not look like ${key}; nothing was written" >&2
  exit 1
fi

tmp=$(mktemp "$dir/.secret.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT
if [[ $kind == env ]]; then
  if [[ -f $dest ]]; then
    grep -v -- "^${key}=" "$dest" >"$tmp" || true
  fi
  printf '%s=%s\n' "$key" "$value" >>"$tmp"
else
  printf '%s\n' "$value" >"$tmp"
fi
unset value
chown "$service_user:$service_user" "$tmp" 2>/dev/null || chown "$(stat -c %u "$dir"):$(stat -c %g "$dir")" "$tmp"
chmod 0600 "$tmp"
mv -f -- "$tmp" "$dest"
trap - EXIT
echo "hermes-secret-put: ${key} written to ${dest} (mode 0600, owner ${service_user})" >&2

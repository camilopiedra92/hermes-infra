#!/usr/bin/env python3
"""Collect the health of the Hermes host into a world-readable JSON status file. Ansible managed.

Runs as root from a systemd timer. It reads, it never changes anything. The Hermes cron job
`host-health` (no-agent mode) turns state changes into Telegram messages.
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import time
from pathlib import Path

OUT = Path("/var/lib/hermes-health/status.json")
BACKUP_STATUS = Path("/var/lib/hermes-backup/status.json")
DRILL_STATUS = Path("/var/lib/hermes-backup/drill.json")
EXPECTED = Path("/etc/hermes-health/expected-state.json")
UNIT_DIR = Path("/etc/systemd/system")
STATE_MOUNT = "/home/hermes/.hermes"
# Agent tiers as "name:account" pairs, written by Ansible from bin/hermes/pins.json.
TIERS = [tuple(pair.split(":", 1)) for pair in os.environ.get("HERMES_TIERS", "").split(",") if pair]
BACKUP_MAX_AGE = 26 * 3600
DRILL_MAX_AGE = 40 * 24 * 3600  # monthly, with a week of slack
DISK_WARN = 0.85
MEM_MIN_MB = 300


def run(*cmd: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=30, check=False)


def drift(problems: list[str], info: dict[str, object]) -> None:
    """Compare what the host runs with what the repository declares. Anything extra is state nobody wrote down."""
    try:
        expected = json.loads(EXPECTED.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        problems.append("there is no expected-state manifest to compare the host with")
        return
    found: dict[str, tuple[set[str], set[str]]] = {}

    tables = {" ".join(line.split()[1:3]) for line in run("nft", "list", "tables").stdout.splitlines() if line.startswith("table ")}
    found["nftables table"] = (tables, set(expected["nft_tables"]))

    units = {path.name for path in UNIT_DIR.iterdir() if path.is_file() and path.name.startswith(tuple(expected["unit_prefixes"]))}
    found["system unit"] = (units, set(expected["system_units"]))

    accounts = {line.split(":")[0] for line in run("getent", "passwd").stdout.splitlines() if 1000 <= int(line.split(":")[2]) < 65000}
    found["account"] = (accounts, set(expected["accounts"]))

    open_ports = set()
    for line in run("ss", "-ltnH").stdout.splitlines():
        local = line.split()[3]
        host, _, port = local.rpartition(":")
        if not host.startswith(("127.", "[::1]", "::1")) and "%" not in host and not host.startswith(("100.", "[fd7a:")):
            open_ports.add(port)
    found["port open to the network"] = (open_ports, {str(port) for port in expected["network_ports"]})

    info["drift_checks"] = sum(len(live) for live, _ in found.values())
    for label, (live, wanted) in found.items():
        for extra in sorted(live - wanted):
            problems.append(f"drift: {label} {extra} is on the host and not in the repository")
        for missing in sorted(wanted - live):
            problems.append(f"drift: {label} {missing} is in the repository and not on the host")


def active(unit: str, user: str | None = None) -> bool:
    if user:
        uid = run("id", "-u", user).stdout.strip()
        done = run("runuser", "-u", user, "--", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}",
                   "systemctl", "--user", "is-active", unit)
    else:
        done = run("systemctl", "is-active", unit)
    return done.stdout.strip() == "active"


def main() -> None:
    problems: list[str] = []
    info: dict[str, object] = {}

    for unit in ("ssh", "tailscaled", "nftables", "tinyproxy", "tinyproxy-ops", "auditd", "cron",
                 *(f"tinyproxy-{name}" for name, _ in TIERS)):
        if not active(unit):
            problems.append(f"service {unit} is not active")
    for user in ("hermes", *(account for _, account in TIERS)):
        if not active("hermes-gateway.service", user=user):
            problems.append(f"the Hermes gateway of {user} is not active")
        uid = run("id", "-u", user).stdout.strip()
        enabled = run("runuser", "-u", user, "--", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}",
                      "systemctl", "--user", "is-enabled", "hermes-gateway.service").stdout.strip()
        if enabled != "enabled":
            problems.append(f"the Hermes gateway of {user} is not enabled at boot")

    failed = [line.split()[1] for line in run("systemctl", "--failed", "--no-legend", "--plain").stdout.splitlines() if line.split()]
    if failed:
        problems.append("failed units: " + ", ".join(failed))

    try:
        backup = json.loads(BACKUP_STATUS.read_text(encoding="utf-8"))
        age = time.time() - backup["finished"]
        info["backup_age_hours"] = round(age / 3600, 1)
        if not backup.get("ok"):
            problems.append("the last backup failed: " + str(backup.get("error", "unknown")))
        elif age > BACKUP_MAX_AGE:
            problems.append(f"the last good backup is {age / 3600:.0f} hours old")
        if backup.get("warn"):
            problems.append("the backup repository is close to the R2 free tier")
    except (OSError, ValueError, KeyError):
        problems.append("there is no backup status yet")

    try:
        drill = json.loads(DRILL_STATUS.read_text(encoding="utf-8"))
        info["restore_drill_age_days"] = round((time.time() - drill["finished"]) / 86400, 1)
        if not drill.get("ok"):
            problems.append("the last restore drill failed: " + "; ".join(drill.get("problems", ["unknown"])))
        elif time.time() - drill["finished"] > DRILL_MAX_AGE:
            problems.append("the last good restore drill is more than 40 days old")
    except (OSError, ValueError, KeyError):
        problems.append("there is no restore drill yet")

    drift(problems, info)

    volumes = [("root disk", "/"), ("state volume", STATE_MOUNT)]
    volumes += [(f"{name} state volume", f"/home/{account}/.hermes") for name, account in TIERS]
    for label, path in volumes:
        usage = shutil.disk_usage(path)
        ratio = usage.used / usage.total
        info[label] = round(ratio, 2)
        if ratio > DISK_WARN:
            problems.append(f"{label} is {ratio:.0%} full")

    meminfo = dict(line.split(":", 1) for line in Path("/proc/meminfo").read_text().splitlines())
    available_mb = int(meminfo["MemAvailable"].split()[0]) // 1024
    info["memory_available_mb"] = available_mb
    if available_mb < MEM_MIN_MB:
        problems.append(f"only {available_mb} MB of memory is available")

    if Path("/run/reboot-required").exists():
        info["reboot_required"] = True
    upgrades = run("apt-get", "-s", "upgrade").stdout.count("\nInst ")
    info["pending_upgrades"] = upgrades

    OUT.parent.mkdir(parents=True, exist_ok=True)
    tmp = OUT.with_suffix(".tmp")
    tmp.write_text(json.dumps({"time": int(time.time()), "problems": problems, "info": info}), encoding="utf-8")
    os.chmod(tmp, 0o644)
    tmp.replace(OUT)


if __name__ == "__main__":
    main()

#!/bin/bash
# git credential helper for the bot's administration account (ADR-0029).
#
# It answers only for https://github.com, and only from the token file the owner delivered with
# `sudo hermes-secret-put GITHUB_TOKEN`. The token is never in a git config, a remote URL, an
# environment variable or a command line. For any other host, or with no token file, it says nothing and
# git asks elsewhere (and, with no terminal, fails).
set -euo pipefail

[[ ${1:-} == get ]] || exit 0
token_file=${HERMES_GITHUB_TOKEN_FILE:-$HOME/.config/hermes/github-token}

protocol=""
host=""
while IFS='=' read -r name value; do
  [[ -n $name ]] || break
  case $name in
    protocol) protocol=$value ;;
    host) host=$value ;;
  esac
done || true

[[ $protocol == https && $host == github.com && -r $token_file ]] || exit 0
token=$(head -n 1 -- "$token_file")
[[ -n $token ]] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"

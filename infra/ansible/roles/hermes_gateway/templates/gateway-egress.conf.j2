# {{ ansible_managed }}
# The proxy variables come from the root-owned environment generator (egress-proxy-generator), one proxy per account.
# HTTPS only: nothing the services need is plain HTTP, so HTTP_PROXY is not set.
[Service]
# Claude's own updater, telemetry and error reporting would name hosts the allowlist does not.
Environment="CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"

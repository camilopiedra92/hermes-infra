# {{ ansible_managed }}
# The backend that Hermes Desktop attaches to. It listens on loopback only. Tailscale Serve publishes it to the tailnet
# over HTTPS (the tailnet policy lets only the owner's devices reach tcp/443); nothing is reachable from the internet. Root-owned, so the service user cannot edit it.
[Unit]
Description=Hermes backend for Hermes Desktop (loopback only)
After=network-online.target
Wants=network-online.target
RequiresMountsFor={{ hermes_pins.state.mount }}

[Service]
Type=simple
ExecStart={{ hermes_gateway_cli }} serve --host 127.0.0.1 --port {{ hermes_gateway_serve_port }} --skip-build
WorkingDirectory={{ hermes_pins.state.mount }}
Environment="HERMES_HOME={{ hermes_pins.state.mount }}"
Environment="HERMES_DASHBOARD_PUBLIC_URL={{ hermes_gateway_serve_url }}"
EnvironmentFile={{ hermes_gateway_serve_dir }}/serve.env
Environment="HTTPS_PROXY=http://{{ hermes_pins.egress.nft.proxy_address }}:{{ hermes_pins.egress.nft.proxy_port }}"
Environment="NO_PROXY=localhost,127.0.0.1,::1"
Environment="CLAUDE_SUBSCRIPTION_DIRECTSDK_COMMAND={{ hermes_gateway_claude_binary }}"
Environment="CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"
Environment="DISABLE_AUTOUPDATER=1"
Restart=on-failure
RestartSec=5
MemoryHigh=768M
MemoryMax=1G
TasksMax=512
LimitCORE=0
# Sandbox. The admin backend never starts a container (its terminal is the SSH backend), so it can run without privilege
# escalation. The sandbox tiers cannot: rootless Podman needs the setuid newuidmap, and in a user manager every namespace
# or seccomp option implies NoNewPrivileges. Capability-dropping options (PrivateDevices, ProtectClock, ProtectKernel*)
# need a privileged manager and fail here.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ hermes_pins.state.mount | dirname }}
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @debug @module @reboot @swap @obsolete @raw-io @cpu-emulation
UMask=0077

[Install]
WantedBy=default.target

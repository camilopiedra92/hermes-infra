# {{ ansible_managed }}
# Hermes managed scope, environment layer. World-readable: nothing secret goes here.
# Telegram: when api.telegram.org does not connect, do not discover other addresses over DoH.
HERMES_TELEGRAM_DISABLE_FALLBACK_IPS=true
# Telegram goes through the local proxy that allows named domains. Hermes reads this explicit variable first.
TELEGRAM_PROXY=http://{{ hermes_pins.egress.nft.proxy_address }}:{{ hermes_pins.egress.nft.proxy_port }}
# Pinned here so that the service user cannot add users to its own allowlist. A Telegram numeric id is
# not a secret, and the operator supplies it when applying. It is not in git, and the role keeps the one on the host.
TELEGRAM_ALLOWED_USERS={{ hermes_gateway_allowed_users_effective }}

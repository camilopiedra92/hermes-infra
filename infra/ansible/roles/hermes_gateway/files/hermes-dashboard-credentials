#!/usr/bin/python3
"""Create the Hermes Desktop login once: a random password for the owner, its scrypt hash and a session-signing secret.

Writes <dir>/password (root only) and <dir>/serve.env (readable by the service group). Does nothing when serve.env exists.
The scrypt parameters are those of plugins/dashboard_auth/basic in the pinned Hermes release.
"""

import base64
import grp
import hashlib
import os
import secrets
import sys

N, R, P, DKLEN, SALT = 2**14, 8, 1, 32, 16


def write(path: str, text: str, group: str, mode: int) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as handle:
        handle.write(text)
    os.chown(path, 0, grp.getgrnam(group).gr_gid)
    os.chmod(path, mode)


def main(directory: str, group: str, username: str) -> int:
    env = os.path.join(directory, "serve.env")
    if os.path.exists(env):
        return 0
    password = secrets.token_urlsafe(24)
    salt = secrets.token_bytes(SALT)
    key = hashlib.scrypt(password.encode(), salt=salt, n=N, r=R, p=P, dklen=DKLEN, maxmem=0)
    encoded = "scrypt${}${}${}${}${}".format(N, R, P, base64.b64encode(salt).decode(), base64.b64encode(key).decode())
    write(os.path.join(directory, "password"), password + "\n", "root", 0o600)
    write(
        env,
        "HERMES_DASHBOARD_BASIC_AUTH_USERNAME={}\nHERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH={}\n"
        "HERMES_DASHBOARD_BASIC_AUTH_SECRET={}\n".format(username, encoded, secrets.token_urlsafe(48)),
        group,
        0o640,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(*sys.argv[1:4]))
